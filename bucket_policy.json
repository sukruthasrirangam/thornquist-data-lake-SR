{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DenyNonPipelineAccessToInternalZones",
      "Effect": "Deny",
      "Principal": "*",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject"],
      "Resource": [
        "arn:aws:s3:::BUCKET_NAME/landing/*",
        "arn:aws:s3:::BUCKET_NAME/raw/*",
        "arn:aws:s3:::BUCKET_NAME/staging/*",
        "arn:aws:s3:::BUCKET_NAME/quarantine/*"
      ],
      "Condition": {
        "ArnNotLike": {
          "aws:PrincipalArn": [
            "arn:aws:iam::ACCOUNT_ID:role/LabRole",
            "arn:aws:iam::ACCOUNT_ID:role/voclabs"
          ]
        }
      }
    },
    {
      "Sid": "DenyUnencryptedTransport",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "s3:*",
      "Resource": [
        "arn:aws:s3:::BUCKET_NAME",
        "arn:aws:s3:::BUCKET_NAME/*"
      ],
      "Condition": {
        "Bool": { "aws:SecureTransport": "false" }
      }
    }
  ]
}
