{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListPipelinePrefixes",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::BUCKET_NAME",
      "Condition": {
        "StringLike": {
          "s3:prefix": ["raw/*", "staging/*", "trusted/*", "quarantine/*", "curated/*", "scripts/*"]
        }
      }
    },
    {
      "Sid": "ReadInputZonesAndScripts",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": [
        "arn:aws:s3:::BUCKET_NAME/raw/*",
        "arn:aws:s3:::BUCKET_NAME/staging/*",
        "arn:aws:s3:::BUCKET_NAME/trusted/*",
        "arn:aws:s3:::BUCKET_NAME/scripts/*"
      ]
    },
    {
      "Sid": "WriteOutputZones",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:DeleteObject"],
      "Resource": [
        "arn:aws:s3:::BUCKET_NAME/staging/*",
        "arn:aws:s3:::BUCKET_NAME/trusted/*",
        "arn:aws:s3:::BUCKET_NAME/quarantine/*",
        "arn:aws:s3:::BUCKET_NAME/curated/*"
      ]
    },
    {
      "Sid": "ManageThornquistCatalogOnly",
      "Effect": "Allow",
      "Action": [
        "glue:GetDatabase", "glue:GetTable", "glue:GetTables",
        "glue:CreateTable", "glue:UpdateTable",
        "glue:GetPartitions", "glue:BatchCreatePartition"
      ],
      "Resource": [
        "arn:aws:glue:us-east-1:ACCOUNT_ID:catalog",
        "arn:aws:glue:us-east-1:ACCOUNT_ID:database/thornquist_*",
        "arn:aws:glue:us-east-1:ACCOUNT_ID:table/thornquist_*/*"
      ]
    },
    {
      "Sid": "WriteGlueLogs",
      "Effect": "Allow",
      "Action": ["logs:CreateLogGroup", "logs:CreateLogStream", "logs:PutLogEvents"],
      "Resource": "arn:aws:logs:us-east-1:ACCOUNT_ID:log-group:/aws-glue/*"
    },
    {
      "Sid": "NeverTouchLanding",
      "Effect": "Deny",
      "Action": "s3:*",
      "Resource": "arn:aws:s3:::BUCKET_NAME/landing/*"
    }
  ]
}
