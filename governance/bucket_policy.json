{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DenyNonPipelineAccessToInternalZones",
      "Effect": "Deny",
      "Principal": "*",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject"],
      "Resource": [
        "arn:aws:s3:::thornquist-lake-764541939057/landing/*",
        "arn:aws:s3:::thornquist-lake-764541939057/raw/*",
        "arn:aws:s3:::thornquist-lake-764541939057/staging/*",
        "arn:aws:s3:::thornquist-lake-764541939057/quarantine/*"
      ],
      "Condition": {
        "ArnNotLike": {
          "aws:PrincipalArn": [
            "arn:aws:iam::764541939057:role/LabRole",
            "arn:aws:iam::764541939057:role/voclabs"
          ]
        }
      }
    },
    {
      "Sid": "DenyUnencryptedTransport",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "s3:*",
      "Resource": [
        "arn:aws:s3:::thornquist-lake-764541939057",
        "arn:aws:s3:::thornquist-lake-764541939057/*"
      ],
      "Condition": {
        "Bool": { "aws:SecureTransport": "false" }
      }
    }
  ]
}
