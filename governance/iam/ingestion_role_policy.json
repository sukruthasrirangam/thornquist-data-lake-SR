{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListOnlyIngestionPrefixes",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::thornquist-lake-764541939057",
      "Condition": {
        "StringLike": { "s3:prefix": ["landing/*", "raw/*"] }
      }
    },
    {
      "Sid": "WriteAndReadLanding",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject"],
      "Resource": "arn:aws:s3:::thornquist-lake-764541939057/landing/*"
    },
    {
      "Sid": "WriteRawOnly",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::thornquist-lake-764541939057/raw/*"
    },
    {
      "Sid": "WriteOwnLogs",
      "Effect": "Allow",
      "Action": ["logs:CreateLogGroup", "logs:CreateLogStream", "logs:PutLogEvents"],
      "Resource": [
        "arn:aws:logs:us-east-1:764541939057:log-group:/aws/lambda/ecom-ingest:*",
        "arn:aws:logs:us-east-1:764541939057:log-group:/aws-glue/*"
      ]
    }
  ]
}
